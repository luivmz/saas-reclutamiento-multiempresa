# Isolated environment for the Cypress E2E suite (services app-e2e and queue-e2e, APP_ENV=e2e).
# Create .env.e2e with `npm run e2e:setup` (generates APP_KEY and E2E_TOKEN). Never commit .env.e2e.
# DB_USERNAME / DB_PASSWORD must match the values used by the postgres service (.env).
APP_NAME="SaaS Reclutamiento"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://app-e2e:8000
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Dedicated database: the reset refuses to run against any other one.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reclutamiento_e2e
DB_USERNAME=reclutamiento
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Separate Redis databases and prefixes from development (sessions/queue: 2, cache: 3).
CACHE_STORE=redis
CACHE_PREFIX=reclutamiento-e2e
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PREFIX=reclutamiento-e2e-database-

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@reclutamiento.test"
MAIL_FROM_NAME="${APP_NAME}"

CV_MAX_KB=5120
SEED_ON_BOOT=false

E2E_ENABLED=true
E2E_TOKEN=
E2E_DATABASE=reclutamiento_e2e

VITE_APP_NAME="${APP_NAME}"
