<a:Creator>user</a:Creator>
<a:ModificationDate>1790218314</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>((stage)::text = ANY ((ARRAY[&#39;evaluacion&#39;::character varying, &#39;entrevista&#39;::character varying])::text[]))</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o225">
