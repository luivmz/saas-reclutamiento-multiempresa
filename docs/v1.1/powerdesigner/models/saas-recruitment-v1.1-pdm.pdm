<o:Table Id="o136">
<a:ObjectID>71C0AB9E-5EF6-4428-92F1-5B9EF6AEB094</a:ObjectID>
<a:Name>interviews</a:Name>
<a:Code>interviews</a:Code>
<a:CreationDate>1790218314</a:CreationDate>
<a:Creator>user</a:Creator>
<a:ModificationDate>1790218316</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Comment>Restricciones CHECK de la base (4): interviews_duration_range, interviews_modality_valid, interviews_outcome_valid, interviews_status_consistent. El importador PostgreSQL 9.x conserva una sola por tabla; aqui se restituye su conjuncion (AND), que es equivalente.</a:Comment>
<a:ServerCheckExpression>(((duration_minutes IS NULL) OR ((duration_minutes &gt;= 15) AND (duration_minutes &lt;= 480))))
AND (((modality)::text = ANY ((ARRAY[&#39;presencial&#39;::character varying, &#39;virtual&#39;::character varying])::text[])))
AND (((outcome IS NULL) OR ((outcome)::text = ANY ((ARRAY[&#39;recomendado&#39;::character varying, &#39;recomendado_con_reservas&#39;::character varying, &#39;no_recomendado&#39;::character varying])::text[]))))
AND (((((status)::text = &#39;programada&#39;::text) AND (completed_at IS NULL) AND (outcome IS NULL)) OR (((status)::text = &#39;realizada&#39;::text) AND (completed_at IS NOT NULL) AND (outcome IS NOT NULL))))</a:ServerCheckExpression>
<a:CheckConstraintName>interviews_duration_range</a:CheckConstraintName>
<a:TotalSavingCurrency/>
<c:AttachedRules>
<o:BusinessRule Ref="o230"/>
<o:BusinessRule Ref="o231"/>
<o:BusinessRule Ref="o232"/>
</c:AttachedRules>
