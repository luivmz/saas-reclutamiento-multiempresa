<o:Table Id="o141">
<a:ObjectID>34A3AC8F-080C-4955-882F-99AAB6EA52B7</a:ObjectID>
<a:Name>job_requests</a:Name>
<a:Code>job_requests</a:Code>
<a:CreationDate>1790218314</a:CreationDate>
<a:Creator>user</a:Creator>
<a:ModificationDate>1790218316</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Comment>Restricciones CHECK de la base (3): job_requests_contract_type_valid, job_requests_headcount_positive, job_requests_status_valid. El importador PostgreSQL 9.x conserva una sola por tabla; aqui se restituye su conjuncion (AND), que es equivalente.</a:Comment>
<a:ServerCheckExpression>(((contract_type)::text = ANY ((ARRAY[&#39;tiempo_completo&#39;::character varying, &#39;tiempo_parcial&#39;::character varying, &#39;por_horas&#39;::character varying, &#39;plazo_fijo&#39;::character varying])::text[])))
AND ((headcount &gt;= 1))
AND (((status)::text = ANY ((ARRAY[&#39;borrador&#39;::character varying, &#39;enviado&#39;::character varying, &#39;observado&#39;::character varying, &#39;validado&#39;::character varying, &#39;aprobado&#39;::character varying, &#39;rechazado&#39;::character varying])::text[])))</a:ServerCheckExpression>
<a:CheckConstraintName>job_requests_contract_type_valid</a:CheckConstraintName>
<a:TotalSavingCurrency/>
<c:AttachedRules>
<o:BusinessRule Ref="o233"/>
<o:BusinessRule Ref="o234"/>
</c:AttachedRules>
