<o:Table Id="o152">
<a:ObjectID>BC7F4584-10AD-492A-9540-BCE7FAB56EF8</a:ObjectID>
<a:Name>selection_decisions</a:Name>
<a:Code>selection_decisions</a:Code>
<a:CreationDate>1790218314</a:CreationDate>
<a:Creator>user</a:Creator>
<a:ModificationDate>1790218316</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Comment>Restricciones CHECK de la base (3): selection_decisions_position_valid, selection_decisions_registration_consistent, selection_decisions_score_range. El importador PostgreSQL 9.x conserva una sola por tabla; aqui se restituye su conjuncion (AND), que es equivalente.</a:Comment>
<a:ServerCheckExpression>(((selected_position &gt;= 1) AND (ranked_candidates &gt;= selected_position)))
AND (((selection_registered_by IS NULL) = (selection_registered_at IS NULL)))
AND (((selected_score &gt;= (0)::numeric) AND (selected_score &lt;= (100)::numeric)))</a:ServerCheckExpression>
<a:CheckConstraintName>selection_decisions_position_valid</a:CheckConstraintName>
<a:TotalSavingCurrency/>
<c:AttachedRules>
<o:BusinessRule Ref="o235"/>
<o:BusinessRule Ref="o236"/>
</c:AttachedRules>
