<o:BusinessRule Id="o222">
<a:ObjectID>4E560CEE-C3FA-4325-B7A3-36AE5FB7882A</a:ObjectID>
<a:Name>candidate_documents_type_valid</a:Name>
<a:Code>candidate_documents_type_valid</a:Code>
<a:CreationDate>1790218314</a:CreationDate>
<a:Creator>user</a:Creator>
<a:ModificationDate>1790218314</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>((type)::text = &#39;cv&#39;::text)</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o223">
<a:ObjectID>AD4E373E-5FAC-40D0-837E-B464D8748C0E</a:ObjectID>
<a:Name>candidate_profiles_experience_range</a:Name>
<a:Code>candidate_profiles_experience_range</a:Code>
<a:CreationDate>1790218314</a:CreationDate>
<a:Creator>user</a:Creator>
<a:ModificationDate>1790218314</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Type>5</a:Type>
<a:ServerExpression>((years_of_experience IS NULL) OR ((years_of_experience &gt;= 0) AND (years_of_experience &lt;= 60)))</a:ServerExpression>
</o:BusinessRule>
<o:BusinessRule Id="o224">
<a:ObjectID>D8911727-EF71-4DF2-B838-2369CE97C912</a:ObjectID>
<a:Name>evaluation_criteria_stage_valid</a:Name>
<a:Code>evaluation_criteria_stage_valid</a:Code>
