<c:Procedures>
<o:Procedure Id="o120">
<a:ObjectID>9A7C01BA-5836-4EB2-A185-E9EAE20788A7</a:ObjectID>
<a:Name>audit_logs_append_only</a:Name>
<a:Code>audit_logs_append_only</a:Code>
<a:CreationDate>1790218314</a:CreationDate>
<a:Creator>user</a:Creator>
<a:ModificationDate>1790218314</a:ModificationDate>
<a:Modifier>user</a:Modifier>
<a:Definition>create or replace function %FUNC%([%PROCPRMS%])
() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
    BEGIN
        IF TG_OP = &#39;UPDATE&#39;
            AND OLD.user_id IS NOT NULL
            AND NEW.user_id IS NULL
            AND (to_jsonb(NEW) - &#39;user_id&#39;) = (to_jsonb(OLD) - &#39;user_id&#39;) THEN
            RETURN NEW</a:Definition>
<a:BaseProcedure.Function>1</a:BaseProcedure.Function>
</o:Procedure>
</c:Procedures>
