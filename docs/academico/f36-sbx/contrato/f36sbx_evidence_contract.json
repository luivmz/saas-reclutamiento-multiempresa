    "counterfactual_pair": {"stage": "B", "fields": ["synthetic_id", "synthetic_organization_id", "variant_of", "perturbation", "grupo_sintetico", "source_type", "environment", "hash_algorithm", "content_hash"]},
    "rendered_document": {"stage": "B", "fields": ["synthetic_id", "synthetic_organization_id", "rendered_from", "format", "source_type", "environment", "hash_algorithm", "content_hash"]}
  },
  "closed_values": {
