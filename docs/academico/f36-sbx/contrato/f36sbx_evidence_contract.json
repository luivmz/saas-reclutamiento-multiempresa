    "human_observation": {"stage": "A", "fields": ["synthetic_id", "synthetic_organization_id", "application_token", "author_kind", "author_token", "observation_kind", "text_synthetic", "source_type", "environment", "hash_algorithm", "content_hash"]},
    "relevance_annotation": {"stage": "A", "fields": ["synthetic_id", "synthetic_organization_id", "fragment_id", "criterion_id", "relevance", "annotator_token", "overlap_stratum", "source_type", "environment"]},
