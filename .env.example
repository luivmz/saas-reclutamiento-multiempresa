APP_NAME="SaaS Reclutamiento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (service "postgres"). Development placeholders only: change them for any shared environment.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reclutamiento
DB_USERNAME=reclutamiento
DB_PASSWORD=secret
# Host port bound to 127.0.0.1 (DB tools); change it if 5432 is already in use.
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=reclutamiento

# Redis (service "redis"): sessions/queue in DB 0, cache in DB 1.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Host port bound to 127.0.0.1; change it if 6379 is already in use.
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@reclutamiento.test"
MAIL_FROM_NAME="${APP_NAME}"

CV_MAX_KB=5120

SEED_ON_BOOT=false

# Cypress E2E support (/__e2e/*) stays DISABLED in this environment: the suite runs against the isolated
# app-e2e service configured in .env.e2e (see .env.e2e.example and docs/docker.md). Never enable in production.
E2E_ENABLED=false
E2E_TOKEN=
E2E_DATABASE=reclutamiento_e2e
# Host port of app-e2e (127.0.0.1), used by `npm run cy:open`.
E2E_APP_PORT=8001

VITE_APP_NAME="${APP_NAME}"
